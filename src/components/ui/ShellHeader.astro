---
/**
 * ShellHeader: top bar with brand and composable actions.
 * Prefer the `actions` slot for CompanyPicker, UserMenu, and custom controls.
 * When the slot is omitted, optional default CompanyPicker + UserMenu are shown for ShellLayout convenience.
 */
import CompanyPicker from './CompanyPicker.astro';
import type { CompanyOption } from './CompanyPicker.astro';
import UserMenu from './UserMenu.astro';
import Icon from './Icon.astro';

interface Props {
  productName?: string;
  logoSrc?: string;
  companyName?: string;
  showCompanyPicker?: boolean;
  companyColor?: string;
  companies?: CompanyOption[];
  userName?: string;
  userSrc?: string;
  class?: string;
}

const {
  productName = 'Harmony',
  logoSrc = '/logos/CPVPLogo.svg',
  companyName = 'Company name',
  showCompanyPicker = true,
  companyColor,
  companies,
  userName = 'User',
  userSrc,
  class: className = '',
} = Astro.props;

const hasActionsSlot = Astro.slots.has('actions');
const effectiveCompanyColor =
  companyColor ?? companies?.[0]?.color ?? '#FF507B';
---

<header class={`header ${className}`}>
  <div class="header__brand">
    <a href="/" class="header__brand-link">
      <img src={logoSrc} alt="" class="header__logo" />
      <span class="header__title">{productName}</span>
    </a>
  </div>

  <div class="header__actions">
    {hasActionsSlot ? (
      <slot name="actions" />
    ) : (
      <>
        {showCompanyPicker && (
          <>
            <CompanyPicker
              companyName={companyName}
              companyColor={companyColor}
              companies={companies}
            />
            <div class="divider"></div>
          </>
        )}
        <UserMenu name={userName} src={userSrc}>
          <button type="button"><Icon name="user" size="sm" class="user-menu__item-icon" />Profile</button>
          <button type="button"><Icon name="arrow-right-on-rectangle" size="sm" class="user-menu__item-icon" />Sign out</button>
        </UserMenu>
      </>
    )}
  </div>

  <div
    class="header__gradient"
    data-header-gradient
    style={effectiveCompanyColor ? `background: linear-gradient(to right, ${effectiveCompanyColor}05, ${effectiveCompanyColor} 50%, ${effectiveCompanyColor}05)` : undefined}
  ></div>
</header>

<script>
  function rgbToHex(rgb: string): string {
    if (!rgb || rgb.startsWith('#')) return rgb;
    const values = rgb.match(/\d+/g);
    if (!values || values.length < 3) return rgb;
    const r = parseInt(values[0]).toString(16).padStart(2, '0');
    const g = parseInt(values[1]).toString(16).padStart(2, '0');
    const b = parseInt(values[2]).toString(16).padStart(2, '0');
    return `#${r}${g}${b}`.toUpperCase();
  }

  function bindHeaderCompanyGradient() {
    document.querySelectorAll('.header').forEach((header) => {
      if (header.hasAttribute('data-gradient-bound')) return;
      header.setAttribute('data-gradient-bound', 'true');
      header.addEventListener('company-change', ((e: CustomEvent) => {
        const color = e.detail?.color as string | undefined;
        const gradient = header.querySelector('[data-header-gradient]') as HTMLElement | null;
        if (!gradient || !color) return;
        const hex = rgbToHex(color);
        gradient.style.background = `linear-gradient(to right, ${hex}05, ${hex} 50%, ${hex}05)`;
      }) as EventListener);
    });
  }

  bindHeaderCompanyGradient();
  document.addEventListener('astro:page-load', bindHeaderCompanyGradient);
</script>
