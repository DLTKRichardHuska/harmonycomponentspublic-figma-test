    "./vp/AGENTS.md": "./dist-products/vp/AGENTS.md",
    "./vp/llms.txt": "./dist-products/vp/llms.txt",
    "./vp/docs/*": "./dist-products/vp/docs/*",
    "./vp/registry/*": "./dist-products/vp/registry/*",
