      "types": "./dist-products/maconomy/src/theme/index.tsx",
      "import": "./dist-products/maconomy/src/theme/index.tsx"
    },
    "./maconomy/components": {
      "types": "./dist-products/maconomy/src/components/index.ts",
      "import": "./dist-products/maconomy/src/components/index.ts"
    },
    "./maconomy/utils": {
      "types": "./dist-products/maconomy/src/lib/utils.ts",
