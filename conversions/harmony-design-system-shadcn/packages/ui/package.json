      "types": "./dist-products/cp/src/lib/utils.ts",
      "import": "./dist-products/cp/src/lib/utils.ts"
    },
    "./cp/styles/*": "./dist-products/cp/src/styles/*",
    "./cp/registry.json": "./dist-products/cp/registry.json",
    "./cp/AGENTS.md": "./dist-products/cp/AGENTS.md",
