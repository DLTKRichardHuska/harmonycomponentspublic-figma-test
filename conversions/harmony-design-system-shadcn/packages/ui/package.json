      "types": "./dist-products/ppm/src/index.ts",
      "import": "./dist-products/ppm/src/index.ts"
    },
    "./ppm/theme": {
      "types": "./dist-products/ppm/src/theme/index.tsx",
      "import": "./dist-products/ppm/src/theme/index.tsx"
    },
    "./ppm/components": {
      "types": "./dist-products/ppm/src/components/index.ts",
      "import": "./dist-products/ppm/src/components/index.ts"
    },
    "./ppm/utils": {
      "types": "./dist-products/ppm/src/lib/utils.ts",
      "import": "./dist-products/ppm/src/lib/utils.ts"
    },
    "./ppm/styles/*": "./dist-products/ppm/src/styles/*",
    "./ppm/registry.json": "./dist-products/ppm/registry.json",
    "./ppm/AGENTS.md": "./dist-products/ppm/AGENTS.md",
    "./ppm/llms.txt": "./dist-products/ppm/llms.txt",
    "./ppm/docs/*": "./dist-products/ppm/docs/*",
    "./ppm/registry/*": "./dist-products/ppm/registry/*",
